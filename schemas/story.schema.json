{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Viet Ky catalogue-aligned contract. ID/reference existence, historical accuracy, asset availability and publication need separate validation and human review.",
  "title": "Viet Ky Story",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "entityId",
    "articleId",
    "title",
    "status",
    "scenes"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 7,
      "maxLength": 7,
      "pattern": "^(sty)[0-9]{4}$"
    },
    "entityId": {
      "type": "string",
      "minLength": 7,
      "maxLength": 7,
      "pattern": "^(evt|per|ppl|plc|cul)[0-9]{4}$"
    },
    "articleId": {
      "type": "string",
      "minLength": 7,
      "maxLength": 7,
      "pattern": "^(art)[0-9]{4}$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "review",
        "published"
      ]
    },
    "scenes": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "type"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 6,
                "maxLength": 6,
                "pattern": "^scn[0-9]{3}$"
              },
              "type": {
                "const": "hero"
              },
              "heading": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "narration": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "imageId": {
                "type": "string",
                "minLength": 7,
                "maxLength": 7,
                "pattern": "^(img)[0-9]{4}$"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "type",
              "sectionIds"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 6,
                "maxLength": 6,
                "pattern": "^scn[0-9]{3}$"
              },
              "type": {
                "const": "narrative"
              },
              "heading": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "narration": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "sectionIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 6,
                  "maxLength": 6,
                  "pattern": "^sec[0-9]{3}$"
                },
                "uniqueItems": true,
                "minItems": 1
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "type",
              "imageId"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 6,
                "maxLength": 6,
                "pattern": "^scn[0-9]{3}$"
              },
              "type": {
                "const": "image"
              },
              "heading": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "narration": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "imageId": {
                "type": "string",
                "minLength": 7,
                "maxLength": 7,
                "pattern": "^(img)[0-9]{4}$"
              },
              "sectionIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 6,
                  "maxLength": 6,
                  "pattern": "^sec[0-9]{3}$"
                },
                "uniqueItems": true,
                "minItems": 1
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "type",
              "mapId"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 6,
                "maxLength": 6,
                "pattern": "^scn[0-9]{3}$"
              },
              "type": {
                "const": "map"
              },
              "heading": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "narration": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "mapId": {
                "type": "string",
                "minLength": 7,
                "maxLength": 7,
                "pattern": "^(map)[0-9]{4}$"
              },
              "sectionIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 6,
                  "maxLength": 6,
                  "pattern": "^sec[0-9]{3}$"
                },
                "uniqueItems": true,
                "minItems": 1
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "type",
              "timelineId"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 6,
                "maxLength": 6,
                "pattern": "^scn[0-9]{3}$"
              },
              "type": {
                "const": "timeline"
              },
              "heading": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "narration": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "timelineId": {
                "type": "string",
                "minLength": 7,
                "maxLength": 7,
                "pattern": "^(tml)[0-9]{4}$"
              },
              "sectionIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 6,
                  "maxLength": 6,
                  "pattern": "^sec[0-9]{3}$"
                },
                "uniqueItems": true,
                "minItems": 1
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "type",
              "imageIds"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 6,
                "maxLength": 6,
                "pattern": "^scn[0-9]{3}$"
              },
              "type": {
                "const": "gallery"
              },
              "heading": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "narration": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "imageIds": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 7,
                  "maxLength": 7,
                  "pattern": "^(img)[0-9]{4}$"
                },
                "minItems": 1
              },
              "sectionIds": {
                "type": "array",
                "uniqueItems": true,
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 6,
                  "maxLength": 6,
                  "pattern": "^sec[0-9]{3}$"
                }
              }
            }
          }
        ]
      },
      "uniqueItems": true,
      "minItems": 0
    },
    "sourceIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 7,
        "maxLength": 7,
        "pattern": "^(src)[0-9]{4}$"
      },
      "uniqueItems": true,
      "minItems": 0
    },
    "editorialNotes": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "description": "Ghi chú biên tập nguyên văn; không phải nội dung lịch sử đã được duyệt."
    },
    "referencedByIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 7,
        "maxLength": 7,
        "pattern": "^(evt|per|ppl|plc|cul|art|sty|tml|src|img|map)[0-9]{4}$"
      },
      "description": "Tham chiếu ngược trong danh mục; không tự suy ra quan hệ lịch sử hoặc quan hệ có hướng."
    },
    "coverImageId": {
      "type": "string",
      "minLength": 7,
      "maxLength": 7,
      "pattern": "^(img)[0-9]{4}$",
      "description": "Ảnh đại diện dự kiến; có ID không chứng minh tệp ảnh đã tồn tại."
    },
    "fallbackImageId": {
      "type": "string",
      "minLength": 7,
      "maxLength": 7,
      "pattern": "^(img)[0-9]{4}$",
      "description": "Ảnh thay thế khi thiếu tệp; danh mục hiện dùng img0025, bản thân tệp cũng cần được tạo và duyệt."
    },
    "imageIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 7,
        "maxLength": 7,
        "pattern": "^(img)[0-9]{4}$"
      }
    },
    "mapIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 7,
        "maxLength": 7,
        "pattern": "^(map)[0-9]{4}$"
      }
    },
    "timelineIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 7,
        "maxLength": 7,
        "pattern": "^(tml)[0-9]{4}$"
      }
    },
    "template": {
      "type": "string",
      "enum": [
        "event",
        "period",
        "person",
        "place",
        "culture"
      ],
      "description": "Template theo chủ thể chính của Story trong danh mục."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "published"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "scenes": {
            "minItems": 5,
            "maxItems": 5
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "template": {
            "const": "event"
          }
        },
        "required": [
          "template"
        ]
      },
      "then": {
        "properties": {
          "entityId": {
            "pattern": "^evt[0-9]{4}$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "template": {
            "const": "period"
          }
        },
        "required": [
          "template"
        ]
      },
      "then": {
        "properties": {
          "entityId": {
            "pattern": "^per[0-9]{4}$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "template": {
            "const": "person"
          }
        },
        "required": [
          "template"
        ]
      },
      "then": {
        "properties": {
          "entityId": {
            "pattern": "^ppl[0-9]{4}$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "template": {
            "const": "place"
          }
        },
        "required": [
          "template"
        ]
      },
      "then": {
        "properties": {
          "entityId": {
            "pattern": "^plc[0-9]{4}$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "template": {
            "const": "culture"
          }
        },
        "required": [
          "template"
        ]
      },
      "then": {
        "properties": {
          "entityId": {
            "pattern": "^cul[0-9]{4}$"
          }
        }
      }
    }
  ]
}
